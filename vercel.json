{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "{*.html,logo.png,character.js,character.json,css/**,js/**,JPG/**}"
    }
  },
  "rewrites": [
    { "source": "/lab", "destination": "/lab.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/story", "destination": "/story.html" },
    { "source": "/favicon.ico", "destination": "/logo.png" },
    { "source": "/favicon.png", "destination": "/logo.png" },
    { "source": "/v1/chat/completions", "destination": "/api/index" },
    { "source": "/v1/audio/transcriptions", "destination": "/api/index" },
    { "source": "/tarot/random", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/api/privacy/:path*", "destination": "/api/index" },
    { "source": "/api/contact/:path*", "destination": "/api/index" },
    { "source": "/api/blog/:path*", "destination": "/api/index" },
    { "source": "/api/weather", "destination": "/api/index" },
    { "source": "/api/maps/:path*", "destination": "/api/index" }
  ]
}
